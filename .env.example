# Copia este archivo como ".env" y completa tu API key gratuita de Groq
# Consiguela en: https://console.groq.com  (Sign up gratis -> API Keys -> Create API Key)
GROQ_API_KEY=

# Modelo de Groq a usar (gratis). Alternativas: qwen/qwen3.6-27b, openai/gpt-oss-20b (mas rapido)
GROQ_MODEL=openai/gpt-oss-20b
REASONING_EFFORT=low

# Modelo de embeddings (gratis, corre local, soporta espanol)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Numero de fragmentos de contexto que se recuperan por pregunta
TOP_K=3

# Documentos que siempre se incluyen en el contexto (ademas de los recuperados
# por similitud), separados por coma. Vacio = ninguno (recomendado).
# Ejemplo: si subes un documento de contactos y quieres que este siempre presente:
#   ALWAYS_INCLUDE_SOURCES=contactos.md
ALWAYS_INCLUDE_SOURCES=

# Panel de administracion (/admin): token OBLIGATORIO para usarlo.
# Si lo dejas vacio, la API de administracion rechaza todas las peticiones.
# Genera uno largo, p. ej.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# Solo desarrollo local: permite usar el panel SIN token. NUNCA en produccion.
ALLOW_INSECURE_ADMIN=false

# Distancia coseno maxima (0 = identico) para aceptar un fragmento recuperado.
# Los mas lejanos se descartan para que el buho no reciba contexto sin relacion.
# 0.85 esta calibrado con `python -m evaluacion.run_eval --sweep`. Vacio = sin umbral.
MAX_DISTANCE=0.85

# Reescribe las preguntas de seguimiento ("¿y cuando es?") usando el historial
# antes de buscar. Hace 1 llamada extra, corta, al LLM por pregunta con historial.
REWRITE_QUERY=true
# Modelo para la reescritura (vacio = el mismo GROQ_MODEL). Uno mas pequeno y
# rapido, p. ej. openai/gpt-oss-20b, reduce latencia.
REWRITE_MODEL=

# Tamano maximo por archivo subido desde el panel de administracion (MB)
MAX_UPLOAD_MB=20

# Rutas (puedes dejarlas por defecto)
CHROMA_PATH=./chroma_db
DOCUMENTOS_PATH=./documentos
